# Pod-only overrides. Layered AFTER .env in each unit's EnvironmentFile= list,
# so these win; .env stays the single source of truth shared with docker-compose.yml.
#
# Why this file exists: pod members share one network namespace, so podman writes
# /etc/hosts entries keyed on ContainerName pointing at 127.0.0.1, and per-container
# NetworkAlias= no longer applies (the alias belongs to the pod's netns). Two Immich
# defaults therefore stop resolving under a pod:
#
#   REDIS_HOSTNAME               default "redis"                       vs ContainerName immich_redis
#   IMMICH_MACHINE_LEARNING_URL  default http://immich-machine-learning:3003
#                                                                      vs ContainerName immich_machine_learning
#
# Compose still needs the service-name hostnames in .env, so the divergence is
# isolated here rather than edited into .env.

REDIS_HOSTNAME=localhost
IMMICH_MACHINE_LEARNING_URL=http://localhost:3003
DB_HOSTNAME=localhost
