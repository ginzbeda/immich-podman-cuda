[Unit]
Description=Immich Server
Requires=immich-redis.service immich-postgres.service
After=immich-redis.service immich-postgres.service

[Container]
ContainerName=immich_server
Image=ghcr.io/immich-app/immich-server:release
AutoUpdate=registry
Network=immich.network
EnvironmentFile=%h/dev/repo/immich-app/.env
# Bound to loopback, matching docker-compose.yml. Reach it from Windows via
# WSL's localhost forwarding; put a reverse proxy in front for LAN access.
PublishPort=127.0.0.1:2283:2283
# GPU available for hardware video transcoding
AddDevice=nvidia.com/gpu=all

# --- Tiered storage: SSD upload root, with the bulk directories mounted over it
# Mount order matters: a nested mount must follow the mount it sits inside.
# Container paths never change, so re-tiering needs no database change.
# 1. UPLOAD ROOT (SSD) — thumbs and in-flight uploads
Volume=${HOST_MEDIA_LOCATION}:/usr/src/app/upload
# 2. MANAGED LIBRARY (HDD) — originals, mounted over the root's library/ subdir
Volume=${HOST_LIBRARY_LOCATION}:/usr/src/app/upload/library
# 3. BULK IMMICH DATA (HDD) — large or cold, mounted over the SSD upload root.
# NOTE: encoded-video/ holds motion-photo companion videos that are the ONLY
# copy of that data, not just regenerable transcodes. Never delete it blindly.
Volume=${HOST_BULK_LOCATION}/encoded-video:/usr/src/app/upload/encoded-video
Volume=${HOST_BULK_LOCATION}/backups:/usr/src/app/upload/backups
Volume=${HOST_BULK_LOCATION}/profile:/usr/src/app/upload/profile
# 4. EXTERNAL LIBRARY SOURCE (HDD, read-only) — the curated folder tree
Volume=${HOST_IMPORT_LOCATION}:/usr/src/app/external:ro
# TEMPORARY — Photos/ could not be moved into the import tree (open Windows
# handle). Mounted into place so restored asset paths resolve. See .env.
Volume=${HOST_IMPORT_PHOTOS_LOCATION}:/usr/src/app/external/Photos:ro

Volume=/etc/localtime:/etc/localtime:ro

[Service]
# Enables ${HOST_MEDIA_LOCATION} / ${HOST_LIBRARY_LOCATION} /
# ${HOST_BULK_LOCATION} / ${HOST_IMPORT_LOCATION} expansion in the Volume=
# lines above. An unset variable expands to empty and fails the bind mount at
# start, so add HOST_BULK_LOCATION to .env before daemon-reload.
EnvironmentFile=%h/dev/repo/immich-app/.env
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
