# --- DATABASE & AUTH ---
DB_PASSWORD=your_secure_password
DB_HOSTNAME=immich_postgres
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# --- TIERED STORAGE ARCHITECTURE ---
#
# Two locations, each on the tier that suits its access pattern. Keep them
# separate: pointing HOST_MEDIA_LOCATION at a folder that already holds your
# photos makes Immich create its working directories (thumbs/, upload/,
# encoded-video/, backups/, ...) interleaved with your own folders.

# 1. SSD / WORKING DIRS — Immich's upload root.
# Thumbnails, transcodes, profile images, in-flight uploads and DB backups.
# Small files, read constantly while browsing: put this on your fastest disk.
# Recommended: /mnt/e/Media/immich-data
HOST_MEDIA_LOCATION=/path/to/ssd/immich-data

# 2. HDD / CURATED ORIGINALS — read-only source tree for the External Library.
# Your own folder tree (Photos/, Mems/, videos/, Edits/, ...). Immich mounts it
# at /usr/src/app/external, indexes the files in place and never writes here,
# so your foldering is preserved exactly as it is on disk.
#
# It is mounted READ-ONLY and at /usr/src/app/external on purpose. Mounting it
# at /usr/src/app/upload/library instead makes it Immich's managed library,
# which is read-write and subject to the storage-template job — that job would
# rename and move your originals into Immich's own date-based layout.
# Recommended: /mnt/d/Media/library
HOST_LIBRARY_LOCATION=/path/to/hdd/library

# --- VERSIONING ---
IMMICH_VERSION=release

# --- HARDWARE ACCELERATION (NVIDIA) ---
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all,compute,utility,video

# Force Machine Learning to use CUDA (e.g., GTX 1080)
IMMICH_MACHINE_LEARNING_DEVICE=cuda
IMMICH_MACHINE_LEARNING_MODEL_TTL=300

# --- NETWORK ---
# Ensures Immich binds to all interfaces for container networking
IMMICH_HOST=0.0.0.0
