# --- DATABASE & AUTH ---
DB_PASSWORD=your_secure_password
DB_HOSTNAME=immich_postgres
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# --- TIERED STORAGE ARCHITECTURE ---
#
# Four locations, each on the tier that suits its access pattern. Keep them
# separate: pointing HOST_MEDIA_LOCATION at a folder that already holds your
# photos makes Immich create its working directories (thumbs/, upload/,
# encoded-video/, backups/, ...) interleaved with your own folders.
#
# Every path below is a HOST path. The container-side paths never change, which
# is why re-tiering is safe: Immich stores container paths in its database, so
# moving the host side of a bind mount needs no database change.

# 1. SSD / HOT DATA — Immich's upload root.
# Thumbnails and in-flight uploads: small files read constantly while browsing.
# Put this on your fastest disk. The bulk subdirectories below are mounted over
# it, so only the genuinely hot paths actually live here.
# Recommended: /mnt/e/Media/immich-data
HOST_MEDIA_LOCATION=/path/to/ssd/immich-data

# 2. HDD / BULK — the managed library (your original photos and videos).
# Mounted over HOST_MEDIA_LOCATION's library/ subdirectory, so originals land
# on high-capacity storage while everything else stays on the SSD.
# Recommended: /mnt/d/Media/library
HOST_LIBRARY_LOCATION=/path/to/hdd/library

# 3. HDD / IMPORT — read-only source tree for an External Library.
# Immich indexes these files in place and never writes here. Point it at an
# empty directory if you upload everything through the app instead.
# Recommended: /mnt/d/Media/immich-import
HOST_IMPORT_LOCATION=/path/to/hdd/immich-import

# 4. HDD / IMMICH BULK DATA — Immich-generated data that is large or cold.
# Transcodes (encoded-video/), database backups (backups/) and profile images
# (profile/). Each is mounted over the matching subdirectory of the upload root,
# the same trick HOST_LIBRARY_LOCATION uses for library/.
# Transcodes stream sequentially, so HDD is fine; on WSL/9p expect playback to
# take about a second longer to start than it would from SSD.
# Recommended: /mnt/d/Media/Immich-Data
HOST_BULK_LOCATION=/path/to/hdd/Immich-Data

# --- VERSIONING ---
IMMICH_VERSION=release

# --- HARDWARE ACCELERATION (NVIDIA) ---
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all,compute,utility,video

# Force Machine Learning to use CUDA (e.g., GTX 1080)
IMMICH_MACHINE_LEARNING_DEVICE=cuda
IMMICH_MACHINE_LEARNING_MODEL_TTL=300

# --- NETWORK ---
# Ensures Immich binds to all interfaces for container networking
IMMICH_HOST=0.0.0.0
